diff --git a/functions/services/brandVoice.js b/functions/services/brandVoice.js
new file mode 100644
--- /dev/null
+++ b/functions/services/brandVoice.js
@@ -0,0 +1,32 @@
+'use strict';
+
+const TONES = Object.freeze([
+  ['warm', ['cercano', 'cercana']],
+  ['professional', ['profesional']],
+  ['conversational', ['informal']],
+  ['formal', ['formal']],
+  ['friendly', ['amable']],
+  ['cheerful', ['alegre']],
+  ['empathetic', ['empatico', 'empatica']],
+  ['respectful', ['respetuoso', 'respetuosa']],
+  ['clear', ['claro', 'clara']],
+  ['direct', ['directo', 'directa']],
+]);
+const ALIASES = new Map(TONES.flatMap(([tone, labels]) => labels.map(label => [label, tone])));
+const empty = status => ({ status, voice: { tones: [] } });
+
+function projectVoice(value) {
+  if (value === undefined) return empty('unconfigured');
+  if (typeof value !== 'string' || value.length > 1200) return empty('unsupported');
+  const normalized = value.normalize('NFKC').toLowerCase().normalize('NFD').replace(/\p{M}/gu, '').trim();
+  if (normalized.length > 1200) return empty('unsupported');
+  if (!normalized) return empty('unconfigured');
+  const labels = normalized.split(/[,;\r\n]/).map(label => label.trim()).filter(Boolean);
+  // No rescatar etiquetas conocidas de un texto que también contiene información libre.
+  if (!labels.length || labels.some(label => !ALIASES.has(label))) return empty('unsupported');
+  const selected = new Set(labels.map(label => ALIASES.get(label)));
+  if (selected.has('formal') && selected.has('conversational')) return empty('unsupported');
+  return { status: 'ready', voice: { tones: TONES.map(([tone]) => tone).filter(tone => selected.has(tone)) } };
+}
+
+module.exports = { projectVoice };
