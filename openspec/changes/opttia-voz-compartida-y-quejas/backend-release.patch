new file mode 100644
--- /dev/null
+++ b/functions/tools/getCompanyBrandVoice.js
@@ -0,0 +1,15 @@
+'use strict';
+
+module.exports = {
+  name: 'get_company_brand_voice',
+  description: 'Lee solo rasgos controlados de tono del comercio autenticado para el chat básico. No entrega perfil libre, documentos ni políticas.',
+  requiredPermissions: ['read'],
+  inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+  async execute(_args, context) {
+    const company = context?.mcpCompany;
+    if (context?.mcpEmbeddedBasic !== true || typeof company !== 'string' || !company.trim() || company.trim() === '*') {
+      throw new Error('Esta lectura requiere una consulta autorizada del chat básico de Katuq.');
+    }
+    return require('../services/brandKnowledge').getVoice(company);
+  },
+};
