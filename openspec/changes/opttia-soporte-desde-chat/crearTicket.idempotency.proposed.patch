+const { hashSupportContent } = require('../opttiaSupportProposal');
+
+// Solo opciones internas verificadas del MCP integrado, nunca datos del cuerpo.
+function intentError(code = 'OPTTIA_SUPPORT_INTENT_INVALID') {
+  const error = new Error(code === 'OPTTIA_SUPPORT_RESULT_UNCERTAIN'
+    ? 'No se pudo comprobar el resultado del ticket. Reintenta la misma propuesta.'
+    : 'La intención del ticket no coincide con los datos autorizados.');
+  error.code = code;
+  return error;
+}
+
+function validateIntent(raw, body) {
+  if (raw === undefined) return null;
+  try {
+    if (!raw || raw.version !== 1 || typeof raw.docId !== 'string'
+      || !/^opttia_[a-f0-9]{64}$/.test(raw.docId) || raw.company !== body.company
+      || typeof raw.actorId !== 'string' || !raw.actorId.trim()
+      || typeof raw.approvedAt !== 'string' || !Number.isFinite(Date.parse(raw.approvedAt))
+      || raw.contentHash !== hashSupportContent({
+        asunto: body.asunto, descripcion: body.descripcion, adjuntos: body.adjuntos,
+      })) throw intentError();
+    return { version: 1, docId: raw.docId, company: raw.company, actorId: raw.actorId,
+      contentHash: raw.contentHash, approvedAt: raw.approvedAt };
+  } catch (_) { throw intentError(); }
+}
+
+function resultForIntent(snapshot, intent) {
+  if (!snapshot.exists) return null;
+  const datos = snapshot.data(), origin = datos.opttiaSupportIntent;
+  try {
+    if (datos.company !== intent.company || !origin || origin.version !== 1
+      || origin.intentId !== intent.docId || origin.actorId !== intent.actorId
+      || origin.contentHash !== intent.contentHash
+      || !Number.isSafeInteger(datos.nroTicket) || datos.nroTicket <= 0
+      || hashSupportContent({ asunto: datos.asunto, descripcion: datos.descripcion,
+        adjuntos: datos.adjuntos }) !== intent.contentHash) throw intentError();
+  } catch (_) { throw intentError(); }
+  return { id: snapshot.id, nroTicket: datos.nroTicket, datos, existing: true };
+}
 
