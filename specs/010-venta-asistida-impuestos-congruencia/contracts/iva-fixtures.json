{
  "meta": {
    "spec": "010-venta-asistida-impuestos-congruencia",
    "version": "1.0.0",
    "fecha": "2026-06-25",
    "descripcion": "Fixtures dorados = contrato de cálculo. FE (PaymentService) y BE (orderCalculationService) DEBEN producir estos resultados exactos. Si divergen, falla el test.",
    "jerarquiaPrecio": ["manual (si permitePrecioManual)", "tipoCliente/categoria", "volumen", "base"],
    "ancla": "IVA = precioSinIVA_resuelto * (tarifaVigente/100). tarifaVigente = _ivaManualOverride si configurado, si no la de la fuente de precio. Nunca confiar en montos de IVA pre-guardados.",
    "camposEsperado": {
      "subtotalSinDescuento": "Σ (precioSinIVA_resuelto * cantidad) + adiciones/preferencias sin IVA",
      "totalDescuento": "subtotalSinDescuento * porceDescuento/100",
      "totalImpuesto": "Σ por línea: sinIVA * tarifa/100 * cantidad * (1 - porceDescuento/100)",
      "desgloseIVA": "totalImpuesto repartido por tarifa {0,5,8,19}",
      "totalEnvio": "costo de envío SIN IVA (base); 0 si no hay domicilio",
      "total": "subtotalSinDescuento - totalDescuento + totalEnvio + totalImpuesto"
    },
    "envio": "El envío (domicilio) lleva IVA con la TARIFA DE LA ZONA (impuestoZonaCobro). totalEnvio se guarda SIN IVA. ivaEnvio = totalEnvio * tarifaEnvio/100, calculado UNA sola vez dentro de totalImpuesto. La tarifa del envío se persiste en el pedido (tarifaEnvio) para no depender de allBillingZone. (D-058)",
    "toleranciaRedondeo": 0.01
  },
  "casos": [
