/* REPLACE THE MOBILE RESPONSIVE SECTION (lines ~823-838): */
// Mobile responsive styles for improved button layout
@media (max-width: 768px) {
  .seguimiento-cell {
    padding: 8px 4px !important;

    .tracking-actions-group,
    .enviame-actions-group {
      gap: 6px; // Slightly reduced gap on mobile
      max-width: 140px; // Smaller max width on mobile

      .p-button {
        font-size: 0.75rem !important;
        padding: 6px 8px !important; // Smaller padding on mobile
        min-height: 32px !important;

        .pi {
          font-size: 0.75rem !important;
        }
      }
    }
  }

  .enviame-info-badge .badge {
    font-size: 0.7rem;
    padding: 4px 8px; // Consistent padding with 4px multiples
  }
}

/* OVERRIDE DEFAULT BUTTON STYLES IN SEGUIMIENTO CELLS */
/* Add this after line ~391: */
:host ::ng-deep .seguimiento-cell {
  .p-button {
    // Override the default small button styles
    &.p-button-sm {
      height: auto !important;
      padding: 8px 12px !important;
      font-size: 0.8rem !important;
    }

    // Ensure outlined buttons have proper styling
    &.p-button-outlined {
      font-weight: 500 !important;
      transition: all 0.2s ease !important;
    }
  }
}